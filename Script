    let changeButton = NSButton(title: "Change…", target: nil, action: nil)
    let resetButton = NSButton(title: "Reset to DEVONthink Default", target: nil, action: nil)
    let launchButton = NSButton(title: "Launch DEVONthink", target: nil, action: nil)
    var filtered: [PreferenceSpec] = []
    var keyMonitor: Any?
    var sliderTargets: [SliderTarget] = []

    var selected: PreferenceSpec? {
        let r = table.selectedRow
        return (r >= 0 && r < filtered.count) ? filtered[r] : nil
    }

    func applicationDidFinishLaunching(_ notification: Notification) {
        buildUI(); refreshFilter(); window.center(); window.makeKeyAndOrderFront(nil); NSApp.activate(ignoringOtherApps: true); search.becomeFirstResponder()
    }

    func buildUI() {
        window.title = "DEVONthink — Curated Preferences (\(allSpecs.count) defined controls)"
        window.delegate = self
        window.isReleasedWhenClosed = false
        guard let content = window.contentView else { return }

        search.translatesAutoresizingMaskIntoConstraints = false
        search.placeholderString = "Search understood DEVONthink settings…"
        search.delegate = self
        search.sendsSearchStringImmediately = true

        category.translatesAutoresizingMaskIntoConstraints = false
        let cats = ["All Categories"] + Array(Set(allSpecs.map { $0.category })).sorted()
        category.addItems(withTitles: cats)
        category.target = self
        category.action = #selector(filterChanged)

        let nameCol = NSTableColumn(identifier: NSUserInterfaceItemIdentifier("name")); nameCol.title = "Setting"; nameCol.width = 610
        let valueCol = NSTableColumn(identifier: NSUserInterfaceItemIdentifier("value")); valueCol.title = "Current"; valueCol.width = 250
        table.addTableColumn(nameCol); table.addTableColumn(valueCol)
        table.delegate = self; table.dataSource = self; table.rowHeight = 28
        table.target = self; table.doubleAction = #selector(changeSelected)

        let scroll = NSScrollView(); scroll.translatesAutoresizingMaskIntoConstraints = false; scroll.documentView = table; scroll.hasVerticalScroller = true; scroll.autohidesScrollers = false; scroll.borderType = .bezelBorder

        titleLabel.translatesAutoresizingMaskIntoConstraints = false; titleLabel.font = NSFont.boldSystemFont(ofSize: 16)
        descriptionLabel.translatesAutoresizingMaskIntoConstraints = false; descriptionLabel.maximumNumberOfLines = 4
        metaLabel.translatesAutoresizingMaskIntoConstraints = false; metaLabel.font = NSFont.systemFont(ofSize: 11); metaLabel.textColor = .secondaryLabelColor; metaLabel.maximumNumberOfLines = 3

        for b in [changeButton, resetButton, launchButton] { b.translatesAutoresizingMaskIntoConstraints = false }
        changeButton.target = self; changeButton.action = #selector(changeSelected)
        resetButton.target = self; resetButton.action = #selector(resetSelected)
        launchButton.target = self; launchButton.action = #selector(launchDEVONthink)

        [search, category, scroll, titleLabel, descriptionLabel, metaLabel, changeButton, resetButton, launchButton].forEach { content.addSubview($0) }
        NSLayoutConstraint.activate([
            search.topAnchor.constraint(equalTo: content.topAnchor, constant: 14), search.leadingAnchor.constraint(equalTo: content.leadingAnchor, constant: 14), search.widthAnchor.constraint(greaterThanOrEqualToConstant: 480),
            category.centerYAnchor.constraint(equalTo: search.centerYAnchor), category.leadingAnchor.constraint(equalTo: search.trailingAnchor, constant: 12), category.trailingAnchor.constraint(equalTo: content.trailingAnchor, constant: -14),
            scroll.topAnchor.constraint(equalTo: search.bottomAnchor, constant: 10), scroll.leadingAnchor.constraint(equalTo: content.leadingAnchor, constant: 14), scroll.trailingAnchor.constraint(equalTo: content.trailingAnchor, constant: -14), scroll.bottomAnchor.constraint(equalTo: titleLabel.topAnchor, constant: -12),
            titleLabel.leadingAnchor.constraint(equalTo: content.leadingAnchor, constant: 16), titleLabel.trailingAnchor.constraint(equalTo: content.trailingAnchor, constant: -16),
            descriptionLabel.topAnchor.constraint(equalTo: titleLabel.bottomAnchor, constant: 6), descriptionLabel.leadingAnchor.constraint(equalTo: titleLabel.leadingAnchor), descriptionLabel.trailingAnchor.constraint(equalTo: titleLabel.trailingAnchor),
            metaLabel.topAnchor.constraint(equalTo: descriptionLabel.bottomAnchor, constant: 6), metaLabel.leadingAnchor.constraint(equalTo: titleLabel.leadingAnchor), metaLabel.trailingAnchor.constraint(equalTo: titleLabel.trailingAnchor),
            changeButton.topAnchor.constraint(equalTo: metaLabel.bottomAnchor, constant: 10), changeButton.leadingAnchor.constraint(equalTo: titleLabel.leadingAnchor), changeButton.bottomAnchor.constraint(equalTo: content.bottomAnchor, constant: -14),
            resetButton.centerYAnchor.constraint(equalTo: changeButton.centerYAnchor), resetButton.leadingAnchor.constraint(equalTo: changeButton.trailingAnchor, constant: 10),
            launchButton.centerYAnchor.constraint(equalTo: changeButton.centerYAnchor), launchButton.trailingAnchor.constraint(equalTo: content.trailingAnchor, constant: -14)
        ])

        keyMonitor = NSEvent.addLocalMonitorForEvents(matching: .keyDown) { [weak self] e in
            guard let self else { return e }
            if e.keyCode == 53 { self.window.close(); return nil }
            if (e.modifierFlags.contains(.command) && e.charactersIgnoringModifiers?.lowercased() == "f") { self.window.makeFirstResponder(self.search); return nil }
            if e.keyCode == 36 || e.keyCode == 76 { if self.window.firstResponder !== self.search.currentEditor() { self.changeSelected(); return nil } }
            return e
        }
    }

    func controlTextDidChange(_ obj: Notification) { refreshFilter() }
    @objc func filterChanged() { refreshFilter() }

    func refreshFilter() {
        let needle = search.stringValue.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        let chosen = category.titleOfSelectedItem ?? "All Categories"
        filtered = allSpecs.filter { s in
            let catOK = chosen == "All Categories" || s.category == chosen
            let searchOK = needle.isEmpty || s.title.lowercased().contains(needle) || s.help.lowercased().contains(needle) || s.key.lowercased().contains(needle) || s.category.lowercased().contains(needle)
            return catOK && searchOK
        }
        table.reloadData()
        if !filtered.isEmpty { table.selectRowIndexes(IndexSet(integer: 0), byExtendingSelection: false) }
        updateDetails()
    }

    func numberOfRows(in tableView: NSTableView) -> Int { filtered.count }
    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
        guard row >= 0 && row < filtered.count else { return nil }
        let spec = filtered[row]
        let id = NSUserInterfaceItemIdentifier(tableColumn?.identifier.rawValue ?? "cell")
        let cell = tableView.makeView(withIdentifier: id, owner: self) as? NSTableCellView ?? NSTableCellView()
        if cell.textField == nil {
            let label = NSTextField(labelWithString: ""); label.translatesAutoresizingMaskIntoConstraints = false; label.lineBreakMode = .byTruncatingTail
            cell.identifier = id; cell.textField = label; cell.addSubview(label)
            NSLayoutConstraint.activate([label.leadingAnchor.constraint(equalTo: cell.leadingAnchor, constant: 6), label.trailingAnchor.constraint(equalTo: cell.trailingAnchor, constant: -6), label.centerYAnchor.constraint(equalTo: cell.centerYAnchor)])
        }
        cell.textField?.stringValue = (tableColumn?.identifier.rawValue == "value") ? display(spec) : spec.title
        return cell
    }
    func tableViewSelectionDidChange(_ notification: Notification) { updateDetails() }

    func updateDetails() {
        guard let s = selected else { titleLabel.stringValue = ""; descriptionLabel.stringValue = ""; metaLabel.stringValue = ""; changeButton.isEnabled = false; resetButton.isEnabled = false; return }
        titleLabel.stringValue = s.title
        descriptionLabel.stringValue = s.help
        metaLabel.stringValue = "Category: \(s.category)   •   Source: \(s.source)\nCurrent: \(display(s))   •   Technical key: \(s.key)"
        changeButton.isEnabled = true; resetButton.isEnabled = currentRaw(s) != nil
    }

    func prepareWrite() -> Bool {
        do { try terminateDEVONthinkIfNeeded(); return true } catch { showError(error.localizedDescription); return false }
    }

    @objc func resetSelected() {
        guard let s = selected, prepareWrite() else { return }
        do { try resetPreference(s); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    @objc func changeSelected() {
        guard let s = selected else { return }
        switch s.editor {
        case .boolean: editBoolean(s)
        case .choice(let c): editChoice(s, c)
        case .intRange(let min, let max, let step, let unit): editInt(s, min, max, step, unit)
        case .doubleRange(let min, let max, let step, let unit): editDouble(s, min, max, step, unit)
        case .text: editText(s)
        case .multilineText: editMultilineText(s)
        case .color: editColor(s)
        case .path: editPath(s)
        case .font: editFont(s)
        case .extensions: editExtensions(s)
        case .encoding: editEncoding(s)
        case .nsEncoding: editNSEncoding(s)
        }
    }

    func popupAlert(_ s: PreferenceSpec, view: NSView, preferredHeight: CGFloat = 32) -> NSAlert {
        let a = NSAlert(); a.messageText = s.title; a.informativeText = s.help; a.accessoryView = view; a.addButton(withTitle: "Save"); a.addButton(withTitle: "Cancel"); return a
    }

    func editBoolean(_ s: PreferenceSpec) {
        let p = NSPopUpButton(frame: NSRect(x: 0, y: 0, width: 360, height: 28)); p.addItems(withTitles: ["ON", "OFF"])
        if boolValue(currentRaw(s)) == false { p.selectItem(at: 1) }
        let a = popupAlert(s, view: p); guard a.runModal() == .alertFirstButtonReturn, prepareWrite() else { return }
        do { try setPreference(s, .bool(p.indexOfSelectedItem == 0)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editChoice(_ s: PreferenceSpec, _ choices: [Choice]) {
        let p = NSPopUpButton(frame: NSRect(x: 0, y: 0, width: 420, height: 28)); p.addItems(withTitles: choices.map { $0.label })
        if let v = prefValue(from: currentRaw(s)), let i = choices.firstIndex(where: { $0.value == v }) { p.selectItem(at: i) }
        let a = popupAlert(s, view: p); guard a.runModal() == .alertFirstButtonReturn, p.indexOfSelectedItem >= 0, prepareWrite() else { return }
        do { try setPreference(s, choices[p.indexOfSelectedItem].value); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func numberChooser(title: String, min: Double, max: Double, step: Double, current: Double, unit: String) -> (NSView, NSSlider, NSTextField) {
        let box = NSView(frame: NSRect(x: 0, y: 0, width: 460, height: 56))
        let slider = NSSlider(frame: NSRect(x: 0, y: 26, width: 370, height: 24)); slider.minValue = min; slider.maxValue = max; slider.doubleValue = Swift.min(Swift.max(current, min), max); slider.numberOfTickMarks = 0; slider.allowsTickMarkValuesOnly = false
        let field = NSTextField(labelWithString: ""); field.frame = NSRect(x: 380, y: 28, width: 78, height: 22); field.alignment = .right
        let range = NSTextField(labelWithString: "Range: \(String(format: "%.0f", min))–\(String(format: "%.0f", max)) \(unit)   •   Step: \(String(format: "%.0f", step))"); range.frame = NSRect(x: 0, y: 0, width: 460, height: 20); range.textColor = .secondaryLabelColor
        func update() { let snapped = round(slider.doubleValue / step) * step; slider.doubleValue = snapped; field.stringValue = "\(String(format: "%.0f", snapped)) \(unit)" }
        let target = SliderTarget(update); sliderTargets.append(target); slider.target = target; slider.action = #selector(SliderTarget.changed)
        box.addSubview(slider); box.addSubview(field); box.addSubview(range); update(); return (box, slider, field)
    }

    func editInt(_ s: PreferenceSpec, _ min: Int, _ max: Int, _ step: Int, _ unit: String) {
        let cur = (currentRaw(s) as? NSNumber)?.doubleValue ?? Double(min)
        let (v, slider, _) = numberChooser(title: s.title, min: Double(min), max: Double(max), step: Double(step), current: cur, unit: unit)
        let a = popupAlert(s, view: v); guard a.runModal() == .alertFirstButtonReturn, prepareWrite() else { return }
        let value = Int((slider.doubleValue / Double(step)).rounded() * Double(step))
        do { try setPreference(s, .int(value)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editDouble(_ s: PreferenceSpec, _ min: Double, _ max: Double, _ step: Double, _ unit: String) {
        let cur = (currentRaw(s) as? NSNumber)?.doubleValue ?? min
        let (v, slider, _) = numberChooser(title: s.title, min: min, max: max, step: step, current: cur, unit: unit)
        let a = popupAlert(s, view: v); guard a.runModal() == .alertFirstButtonReturn, prepareWrite() else { return }
        let value = (slider.doubleValue / step).rounded() * step
        do { try setPreference(s, .double(value)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editText(_ s: PreferenceSpec) {
        let field = NSTextField(string: (currentRaw(s) as? String) ?? ""); field.frame = NSRect(x: 0, y: 0, width: 460, height: 24)
        let a = popupAlert(s, view: field); a.window.initialFirstResponder = field
        guard a.runModal() == .alertFirstButtonReturn, prepareWrite() else { return }
        do { try setPreference(s, .string(field.stringValue)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editMultilineText(_ s: PreferenceSpec) {
        let scroll = NSScrollView(frame: NSRect(x: 0, y: 0, width: 540, height: 220))
        scroll.hasVerticalScroller = true
        scroll.borderType = .bezelBorder
        let textView = NSTextView(frame: scroll.bounds)
        textView.isVerticallyResizable = true
        textView.isHorizontallyResizable = false
        textView.autoresizingMask = [.width]
        textView.textContainer?.widthTracksTextView = true
        textView.string = (currentRaw(s) as? String) ?? ""
        scroll.documentView = textView
        let a = popupAlert(s, view: scroll, preferredHeight: 220)
        a.window.initialFirstResponder = textView
        guard a.runModal() == .alertFirstButtonReturn, prepareWrite() else { return }
        do { try setPreference(s, .string(textView.string)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editColor(_ s: PreferenceSpec) {
        let box = NSView(frame: NSRect(x: 0, y: 0, width: 420, height: 56))
        let label = NSTextField(labelWithString: "Click the color well, choose the color, then Save.")
        label.frame = NSRect(x: 0, y: 32, width: 330, height: 20)
        label.textColor = .secondaryLabelColor
        let well = NSColorWell(frame: NSRect(x: 340, y: 4, width: 72, height: 44))
        well.color = colorFromRaw(currentRaw(s)) ?? .systemGray
        box.addSubview(label)
        box.addSubview(well)
        let a = popupAlert(s, view: box, preferredHeight: 56)
        guard a.runModal() == .alertFirstButtonReturn, prepareWrite() else { return }
        guard let propertyList = colorPropertyList(well.color) else { showError("macOS could not convert the selected color into DEVONthink's stored color format."); return }
        do { try setRawPreference(s, propertyList); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editPath(_ s: PreferenceSpec) {
        let p = NSOpenPanel(); p.title = s.title; p.message = s.help; p.canChooseDirectories = true; p.canChooseFiles = false; p.allowsMultipleSelection = false
        if let path = currentRaw(s) as? String, !path.isEmpty { p.directoryURL = URL(fileURLWithPath: path) }
        guard p.runModal() == .OK, let url = p.url, prepareWrite() else { return }
        do { try setPreference(s, .string(url.path)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editFont(_ s: PreferenceSpec) {
        let fonts = NSFontManager.shared.availableFontFamilies.sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
        let p = NSPopUpButton(frame: NSRect(x: 0, y: 0, width: 460, height: 28)); p.addItems(withTitles: fonts)
        if let current = currentRaw(s) as? String {
            if let exact = fonts.firstIndex(of: current) { p.selectItem(at: exact) }
            else if let f = NSFont(name: current, size: 12), let i = fonts.firstIndex(of: f.familyName ?? "") { p.selectItem(at: i) }
        }
        let a = popupAlert(s, view: p); guard a.runModal() == .alertFirstButtonReturn, let name = p.titleOfSelectedItem, prepareWrite() else { return }
        do { try setPreference(s, .string(name)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editNSEncoding(_ s: PreferenceSpec) {
        var options: [(label: String, raw: UInt64)] = [("Automatic", 4294967295)]
        var pointer = NSString.availableStringEncodings
        var seen = Set<UInt64>()
        while pointer.pointee != 0 {
            let raw = UInt64(pointer.pointee)
            if !seen.contains(raw) {
                seen.insert(raw)
                let encoding = String.Encoding(rawValue: pointer.pointee)
                let cfEncoding = CFStringConvertNSStringEncodingToEncoding(encoding.rawValue)
                let suffix: String
                if let ianaCF = CFStringConvertEncodingToIANACharSetName(cfEncoding) { suffix = " — \(ianaCF)" } else { suffix = "" }
                options.append(("\(String.localizedName(of: encoding))\(suffix)", raw))
            }
            pointer = pointer.advanced(by: 1)
        }
        let first = options.removeFirst()
        options.sort { $0.label.localizedCaseInsensitiveCompare($1.label) == .orderedAscending }
        options.insert(first, at: 0)
        let p = NSPopUpButton(frame: NSRect(x: 0, y: 0, width: 520, height: 28)); p.addItems(withTitles: options.map { $0.label })
        if let current = currentRaw(s) as? NSNumber, let index = options.firstIndex(where: { $0.raw == current.uint64Value }) { p.selectItem(at: index) }
        let a = popupAlert(s, view: p); guard a.runModal() == .alertFirstButtonReturn, p.indexOfSelectedItem >= 0, prepareWrite() else { return }
        do { try setPreference(s, .int(Int(options[p.indexOfSelectedItem].raw))); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editEncoding(_ s: PreferenceSpec) {
        let encodings = availableEncodings()
        guard !encodings.isEmpty else { showError("macOS did not report any available text encodings."); return }
        let p = NSPopUpButton(frame: NSRect(x: 0, y: 0, width: 520, height: 28)); p.addItems(withTitles: encodings.map { $0.label })
        if let current = currentRaw(s) as? String, let index = encodings.firstIndex(where: { $0.iana.caseInsensitiveCompare(current) == .orderedSame }) { p.selectItem(at: index) }
        let a = popupAlert(s, view: p); guard a.runModal() == .alertFirstButtonReturn, p.indexOfSelectedItem >= 0, prepareWrite() else { return }
        do { try setPreference(s, .string(encodings[p.indexOfSelectedItem].iana)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    func editExtensions(_ s: PreferenceSpec) {
        let p = NSOpenPanel(); p.title = s.title; p.message = "Choose one or more example files. DEVONthink will store their filename extensions for this preference."; p.canChooseDirectories = false; p.canChooseFiles = true; p.allowsMultipleSelection = true
        guard p.runModal() == .OK else { return }
        let exts = Array(Set(p.urls.compactMap { u -> String? in let e=u.pathExtension.trimmingCharacters(in:.whitespacesAndNewlines); return e.isEmpty ? nil : e.lowercased() })).sorted()
        guard !exts.isEmpty else { showError("None of the selected files had a filename extension."); return }
        let value = exts.map { "." + $0 }.joined()
        guard prepareWrite() else { return }
        do { try setPreference(s, .string(value)); table.reloadData(); updateDetails() } catch { showError(error.localizedDescription) }
    }

    @objc func launchDEVONthink() { NSWorkspace.shared.openApplication(at: URL(fileURLWithPath: "/Applications/DEVONthink.app"), configuration: NSWorkspace.OpenConfiguration(), completionHandler: nil) }
    func showError(_ message: String) { let a=NSAlert(); a.alertStyle = .critical; a.messageText = "DEVONthink Preferences"; a.informativeText = message; a.runModal() }
    func windowWillClose(_ notification: Notification) { NSApp.terminate(nil) }
    deinit { if let keyMonitor { NSEvent.removeMonitor(keyMonitor) } }
}

