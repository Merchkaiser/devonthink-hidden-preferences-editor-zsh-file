enum PrefValue: Equatable {
    case bool(Bool)
    case int(Int)
    case double(Double)
    case string(String)
}

struct Choice { let label: String; let value: PrefValue }

enum EditorKind {
    case boolean
    case choice([Choice])
    case intRange(min: Int, max: Int, step: Int, unit: String)
    case doubleRange(min: Double, max: Double, step: Double, unit: String)
    case text
    case multilineText
    case color
    case path
    case font
    case extensions
    case encoding
    case nsEncoding
}

