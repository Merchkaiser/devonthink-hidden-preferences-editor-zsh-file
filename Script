func rawValue(domain: String, key: String) -> Any? {
    CFPreferencesCopyAppValue(key as CFString, domain as CFString)
}

func currentRaw(_ spec: PreferenceSpec) -> Any? {
    if let value = rawValue(domain: spec.domain, key: spec.key) { return value }
    for alias in spec.aliases { if let value = rawValue(domain: spec.domain, key: alias) { return value } }
    return nil
}

func boolValue(_ any: Any?) -> Bool? {
    if let n = any as? NSNumber { return n.boolValue }
    if let s = any as? String {
        switch s.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() {
        case "1", "true", "yes", "on": return true
        case "0", "false", "no", "off": return false
        default: return nil
        }
    }
    return nil
}

func prefValue(from any: Any?) -> PrefValue? {
    guard let any else { return nil }
    if let n = any as? NSNumber {
        let t = String(cString: n.objCType)
        if t == "c" || t == "B" { return .bool(n.boolValue) }
        if t == "f" || t == "d" { return .double(n.doubleValue) }
        return .int(n.intValue)
    }
    if let s = any as? String { return .string(s) }
    return nil
}

struct EncodingOption { let label: String; let iana: String }

func availableEncodings() -> [EncodingOption] {
    var result: [EncodingOption] = []
    var seen = Set<String>()
    var pointer = NSString.availableStringEncodings
    while pointer.pointee != 0 {
        let nsEncoding = pointer.pointee
        let encoding = String.Encoding(rawValue: nsEncoding)
        let cfEncoding = CFStringConvertNSStringEncodingToEncoding(nsEncoding)
        if let ianaCF = CFStringConvertEncodingToIANACharSetName(cfEncoding) {
            let iana = ianaCF as! String
            let lower = iana.lowercased()
            if !seen.contains(lower) {
                seen.insert(lower)
                result.append(EncodingOption(label: "\(String.localizedName(of: encoding)) — \(iana)", iana: iana))
            }
        }
        pointer = pointer.advanced(by: 1)
    }
    return result.sorted { $0.label.localizedCaseInsensitiveCompare($1.label) == .orderedAscending }
}

func colorFromRaw(_ raw: Any?) -> NSColor? {
    guard let dictionary = raw as? [String: Any] else {
        if let dictionary = raw as? NSDictionary {
            return colorFromRaw(dictionary as? [String: Any])
        }
        return nil
    }
    let alpha = (dictionary["alpha"] as? NSNumber)?.doubleValue ?? 1.0
    let space = dictionary["colorSpace"] as? String ?? ""
    if space.contains("White") {
        guard let white = (dictionary["white"] as? NSNumber)?.doubleValue else { return nil }
        return NSColor(calibratedWhite: white, alpha: alpha)
    }
    guard
        let red = (dictionary["red"] as? NSNumber)?.doubleValue,
        let green = (dictionary["green"] as? NSNumber)?.doubleValue,
        let blue = (dictionary["blue"] as? NSNumber)?.doubleValue
    else { return nil }
    return NSColor(calibratedRed: red, green: green, blue: blue, alpha: alpha)
}

func colorPropertyList(_ color: NSColor) -> CFPropertyList? {
    guard let rgb = color.usingColorSpace(.deviceRGB) else { return nil }
    let dictionary: NSDictionary = [
        "alpha": NSNumber(value: rgb.alphaComponent),
        "blue": NSNumber(value: rgb.blueComponent),
        "colorSpace": "NSCalibratedRGBColorSpace",
        "green": NSNumber(value: rgb.greenComponent),
        "red": NSNumber(value: rgb.redComponent)
    ]
    return dictionary as CFPropertyList
}

func colorDisplay(_ raw: Any?) -> String {
    guard let color = colorFromRaw(raw), let rgb = color.usingColorSpace(.deviceRGB) else { return "DEVONthink Default" }
    let r = Int((rgb.redComponent * 255).rounded())
    let g = Int((rgb.greenComponent * 255).rounded())
    let b = Int((rgb.blueComponent * 255).rounded())
    let a = Int((rgb.alphaComponent * 100).rounded())
    return String(format: "#%02X%02X%02X  •  %d%% opacity", r, g, b, a)
}

func display(_ spec: PreferenceSpec) -> String {
    guard let raw = currentRaw(spec) else { return "DEVONthink Default" }
    switch spec.editor {
    case .boolean:
        guard let b = boolValue(raw) else { return "Stored value not recognized" }
        return b ? "ON" : "OFF"
    case .choice(let choices):
        if let v = prefValue(from: raw), let c = choices.first(where: { $0.value == v }) { return c.label }
        if let n = raw as? NSNumber {
            let asInt = PrefValue.int(n.intValue)
            if let c = choices.first(where: { $0.value == asInt }) { return c.label }
        }
        return "Legacy/other stored value"
    case .intRange(_, _, _, let unit):
        if let n = raw as? NSNumber { return "\(n.intValue) \(unit)" }
        return String(describing: raw)
    case .doubleRange(_, _, _, let unit):
        if let n = raw as? NSNumber { return String(format: "%.0f %@", n.doubleValue, unit) }
        return String(describing: raw)
    case .font:
        return (raw as? String) ?? "Stored value not recognized"
    case .path:
        return (raw as? String) ?? "Stored value not recognized"
    case .text:
        return (raw as? String) ?? "Stored value not recognized"
    case .multilineText:
        guard let value = raw as? String else { return "Stored value not recognized" }
        let oneLine = value.replacingOccurrences(of: "\n", with: " ↵ ").trimmingCharacters(in: .whitespacesAndNewlines)
        return oneLine.count > 90 ? String(oneLine.prefix(87)) + "…" : oneLine
    case .color:
        return colorDisplay(raw)
    case .extensions:
        let s = (raw as? String) ?? ""
        return s.isEmpty ? "None" : s
    case .encoding:
        guard let name = raw as? String else { return "Stored value not recognized" }
        if let match = availableEncodings().first(where: { $0.iana.caseInsensitiveCompare(name) == .orderedSame }) { return match.label }
        return name
    case .nsEncoding:
        guard let number = raw as? NSNumber else { return "Stored value not recognized" }
        let stored = number.uint64Value
        if stored == 4294967295 { return "Automatic" }
        let encoding = String.Encoding(rawValue: UInt(stored))
        let cfEncoding = CFStringConvertNSStringEncodingToEncoding(encoding.rawValue)
        if let ianaCF = CFStringConvertEncodingToIANACharSetName(cfEncoding) {
            return "\(String.localizedName(of: encoding)) — \(ianaCF)"
        }
        return String.localizedName(of: encoding)
    }
}

func cfValue(_ value: PrefValue) -> CFPropertyList {
    switch value {
    case .bool(let v): return NSNumber(value: v) as CFPropertyList
    case .int(let v): return NSNumber(value: v) as CFPropertyList
    case .double(let v): return NSNumber(value: v) as CFPropertyList
    case .string(let v): return v as CFString as CFPropertyList
    }
}

func synchronize(_ domain: String) throws {
    guard CFPreferencesAppSynchronize(domain as CFString) else {
        throw NSError(domain: "DEVONthinkCuratedPreferences", code: 10, userInfo: [NSLocalizedDescriptionKey: "macOS could not synchronize the preference domain."])
    }
}

func setPreference(_ spec: PreferenceSpec, _ value: PrefValue) throws {
    CFPreferencesSetAppValue(spec.key as CFString, cfValue(value), spec.domain as CFString)
    for alias in spec.aliases { CFPreferencesSetAppValue(alias as CFString, cfValue(value), spec.domain as CFString) }
    try synchronize(spec.domain)
}

func setRawPreference(_ spec: PreferenceSpec, _ value: CFPropertyList) throws {
    CFPreferencesSetAppValue(spec.key as CFString, value, spec.domain as CFString)
    for alias in spec.aliases { CFPreferencesSetAppValue(alias as CFString, value, spec.domain as CFString) }
    try synchronize(spec.domain)
}

func resetPreference(_ spec: PreferenceSpec) throws {
    CFPreferencesSetAppValue(spec.key as CFString, nil, spec.domain as CFString)
    for alias in spec.aliases { CFPreferencesSetAppValue(alias as CFString, nil, spec.domain as CFString) }
    try synchronize(spec.domain)
}

func terminateDEVONthinkIfNeeded() throws {
    let running = NSRunningApplication.runningApplications(withBundleIdentifier: appBundleID)
    guard !running.isEmpty else { return }
    for app in running { app.terminate() }
    let deadline = Date().addingTimeInterval(6)
    while Date() < deadline {
        if NSRunningApplication.runningApplications(withBundleIdentifier: appBundleID).isEmpty { return }
        RunLoop.current.run(until: Date().addingTimeInterval(0.1))
    }
    throw NSError(domain: "DEVONthinkCuratedPreferences", code: 11, userInfo: [NSLocalizedDescriptionKey: "DEVONthink is still running. Quit DEVONthink completely and try again."])
}

