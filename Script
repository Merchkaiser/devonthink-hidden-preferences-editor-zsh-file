    let help: String
    let source: String
    let editor: EditorKind

    static func bool(category: String, domain: String, key: String, aliases: [String] = [], title: String, help: String, source: String) -> PreferenceSpec {
        PreferenceSpec(category: category, domain: domain, key: key, aliases: aliases, title: title, help: help, source: source, editor: .boolean)
    }
    static func choice(category: String, domain: String, key: String, title: String, help: String, source: String, choices: [Choice]) -> PreferenceSpec {
