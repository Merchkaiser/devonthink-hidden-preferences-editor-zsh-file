#!/bin/zsh
# DEVONthink Curated Preferences Editor (V4)
# Purpose: macOS GUI for editing selected DEVONthink preferences, including advanced/hidden keys.
# Features: categorized search, toggles, choices, numeric ranges, text, paths, fonts, and colors.
# Implementation: zsh creates a temporary Swift/AppKit application and runs it with xcrun swift.
# Requirements: macOS, DEVONthink, and Apple Swift toolchain (xcrun swift).
# Usage: chmod +x DEVONthink_Curated_Preferences_Editor.zsh && ./DEVONthink_Curated_Preferences_Editor.zsh
# Warning: Changes write to DEVONthink preferences; back up settings and quit DEVONthink first.
# Configuration: edit the three YES/NO variables below before launching.
# Note: Unofficial community utility; not affiliated with DEVONtechnologies.
# Curated DEVONthink preferences control panel V4: only understood settings; defined toggles, choices, ranges, source pickers, multiline editors, and native color pickers.

# ================================================================================================================

DO_YOU_WANT_ERROR_POPUPS__YES_NO="YES"
MINIMIZE_LAUNCHING_TERMINAL__YES_NO="YES"
RELAUNCH_DEVONTHINK_AFTER_EDITOR_CLOSES__YES_NO="NO"

TMP_DIR="$(mktemp -d -t devonthink_curated_preferences)"
TMP_SWIFT="$TMP_DIR/DEVONthinkCuratedPreferences.swift"
TMP_ERROR="$TMP_DIR/error.txt"

cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT INT TERM

popup_error() {
    [[ "$DO_YOU_WANT_ERROR_POPUPS__YES_NO" == "YES" ]] || return 0
    /usr/bin/osascript -e 'on run argv' -e 'display alert "DEVONthink Preferences" message (item 1 of argv) as critical' -e 'end run' "$1" >/dev/null 2>&1 || true
}

if [[ "$MINIMIZE_LAUNCHING_TERMINAL__YES_NO" == "YES" && "$TERM_PROGRAM" == "Apple_Terminal" ]]; then
    /usr/bin/osascript -e 'tell application "Terminal" to try' -e 'set miniaturized of front window to true' -e 'end try' >/dev/null 2>&1 || true
fi

command -v xcrun >/dev/null 2>&1 || { popup_error "xcrun was not found."; exit 1; }
xcrun --find swift >/dev/null 2>&1 || { popup_error "Swift was not found. Apple Command Line Tools are required for this GUI script."; exit 1; }

export DEVON_RELAUNCH_AFTER_CLOSE="$RELAUNCH_DEVONTHINK_AFTER_EDITOR_CLOSES__YES_NO"

cat > "$TMP_SWIFT" <<'SWIFT'
