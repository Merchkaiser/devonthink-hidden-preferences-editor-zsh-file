    }
    static func intRange(category: String, domain: String, key: String, title: String, help: String, source: String, min: Int, max: Int, step: Int, unit: String) -> PreferenceSpec {
        PreferenceSpec(category: category, domain: domain, key: key, aliases: [], title: title, help: help, source: source, editor: .intRange(min: min, max: max, step: step, unit: unit))
    }
    static func doubleRange(category: String, domain: String, key: String, title: String, help: String, source: String, min: Double, max: Double, step: Double, unit: String) -> PreferenceSpec {
